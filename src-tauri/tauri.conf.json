{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WTF Helper",
  "mainBinaryName": "wtf-helper",
  "version": "0.1.0",
  "identifier": "com.collaboraitr.wtfhelper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WTF Helper",
        "width": 520,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "collaborAItr",
    "copyright": "Copyright 2026 collaborAItr",
    "category": "Utility",
    "shortDescription": "Read-only computer checks for your collaborAItr guide.",
    "longDescription": "WTF Helper runs read-only checks that your collaborAItr guide asks for, only after you approve them. It changes nothing on your computer.",
    "license": "Apache-2.0",
    "homepage": "https://github.com/collaborAItr/WTF-Helper",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/osquery"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
